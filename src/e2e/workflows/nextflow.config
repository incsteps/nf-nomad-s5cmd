plugins {
    id "nf-nomad@0.4.0-edge7"
    id "nf-nomad-s5cmd@99.99.99"
}

process {
    executor = "nomad"
}

nomad {

    client {
        address = "http://127.0.0.1:4646"
    }

    jobs {
        deleteOnCompletion = true
        namespace = 'nf-nomad'
        nodePool = 'dev'
        volumes = [
            [type: 'host', name: 's5cmd-bin', path: '/opt/abc/bin/']
        ]
        networkMode = 'docker_nomad-s5cmd'
    }

    secrets {
        enabled = true
    }
}

s5cmd {
    enabled = true

    // S3 endpoint + creds (env-driven for safety)
    s3 {
        endpoint        = "${System.getenv('NF_S5CMD_ENDPOINT') ?: 'http://minio:9000'}"
        region          = 'us-east-1'
        accessKeyId     = "${System.getenv('AWS_ACCESS_KEY_ID') ?: 'minioadmin'}"
        secretAccessKey = "${System.getenv('AWS_SECRET_ACCESS_KEY') ?: 'minioadmin'}"
        usePathStyle    = true   // required for MinIO / rustfs
    }

    paths = [ 's3://my-bucket/', 's3://my-bucket/kk' ]

    // s5cmd transfer tunables (applied to every `s5cmd cp` invocation)
    cp {
        concurrency = 5      // -c   parallel parts per file
        numWorkers  = 64     // -numworkers
        retryCount  = 3      // -r
        partSize    = 50     // MB
        logLevel    = 'info'
    }

    // ↓↓↓ Distributed-workdir mode — opt in for non-shared-FS clusters
    workDir {
        enabled            = true
        bucket             = 's3://my-bucket/e2e'
        prefix             = 'sessions/'         // optional sub-path
        completionTimeout  = '60s'               // remote .exitcode poll deadline
    }
}