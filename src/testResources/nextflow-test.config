/*
 * Sample nextflow.config used by integration smoke tests + as a copy-paste
 * starting point for users.
 */

plugins {
    id 'nf-s5cmd@99.99.99'
}

s5cmd {
    enabled = true

    paths = [
        's3://nf-s5cmd-tests/',
    ]

    s3 {
        endpoint        = "${System.getenv('NF_S5CMD_ENDPOINT') ?: 'http://localhost:9000'}"
        region          = 'us-east-1'
        accessKeyId     = "${System.getenv('AWS_ACCESS_KEY_ID') ?: 'minioadmin'}"
        secretAccessKey = "${System.getenv('AWS_SECRET_ACCESS_KEY') ?: 'minioadmin'}"
        usePathStyle    = true
    }

    cp {
        concurrency = 5
        numWorkers  = 64
        retryCount  = 3
        partSize    = 50
        logLevel    = 'INFO'
    }
}
